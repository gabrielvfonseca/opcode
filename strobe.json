{
  "$schema": "https://raw.githubusercontent.com/Hona/strobe/main/schema/strobe.v1.json",
  "build": {
    "command": "cargo build --locked --release --bin opcode",
    "output": {
      "windows": "{cache}/cargo-target/release/opcode.exe",
      "macos": "{cache}/cargo-target/release/opcode",
      "linux": "{cache}/cargo-target/release/opcode"
    },
    "env": {
      "CARGO_TARGET_DIR": "{cache}/cargo-target",
      "CARGO_PROFILE_RELEASE_DEBUG": "line-tables-only",
      "CARGO_PROFILE_RELEASE_STRIP": "false",
      "CARGO_PROFILE_RELEASE_INCREMENTAL": "false",
      "TRANSCRIBE_CMAKE_ARGS": "-DGGML_NATIVE=OFF"
    },
    "windows": {
      "env": { "RUSTUP_TOOLCHAIN": "stable-x86_64-pc-windows-msvc" }
    }
  },
  "apps": {
    "opcode": {
      "kind": "native",
      "exe": {
        "windows": "target/release/opcode.exe",
        "macos": "/Applications/Opcode.app/Contents/MacOS/opcode",
        "linux": "~/.local/share/opcode/current/opcode"
      },
      "args": ["app"],
      "env": {
        "OPCODE_APPLICATION_SUPPORT_DIR": "{home}/opcode-data",
        "OPCODE_DISABLE_UPDATES": "1",
        "HF_HUB_CACHE": "{home}/.cache/huggingface/hub"
      },
      "unset": ["OPCODE_*", "WGPU_*", "RUNE_*", "HF_HOME", "RUST_LOG"],
      "moved": ["~/Library/Application Support/opcode"],
      "files": {
        "opcode-data/onboarding-complete": "",
        "opcode-data/settings.json": {
          "enable_on_launch": false,
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "anomaly-opcode-identity"]
        }
      },
      "guard": [
        { "os": "windows", "file": "%APPDATA%/opcode/local-api.json", "pid": "pid" },
        { "os": "windows", "file": "%APPDATA%/opcode/settings.json" },
        { "os": "macos", "file": "~/Library/Application Support/opcode/local-api.json", "pid": "pid" },
        { "os": "macos", "file": "~/Library/Application Support/opcode/settings.json" },
        { "os": "linux", "file": "~/.local/share/opcode/local-api.json", "pid": "pid" },
        { "os": "linux", "file": "~/.local/share/opcode/settings.json" }
      ]
    },
    "opcode-listening": {
      "extends": "opcode",
      "files": {
        "opcode-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": true,
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "anomaly-opcode-identity"]
        }
      }
    },
    "opcode-listening-warm": {
      "extends": "opcode",
      "files": {
        "opcode-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": false,
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "anomaly-opcode-identity"]
        }
      }
    },
    "opcode-dictation": {
      "extends": "opcode",
      "env": { "OPCODE_AUDIO_FIXTURE": "{home}/speech.wav" },
      "files": {
        "opcode-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": false,
          "sound_effects": false,
          "show_dock_icon": false,
          "dictation_hotkey": { "keys": [{ "code": 80, "label": "F19" }] },
          "paste_last_hotkey": null,
          "capture": { "enabled": true, "hotkey": { "keys": [{ "code": 79, "label": "F18" }] } },
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "annotate-on-by-default", "anomaly-opcode-identity"]
        }
      }
    },
    "opcode-dictation-released": {
      "extends": "opcode-dictation",
      "files": {
        "opcode-data/settings.json": {
          "enable_on_launch": true,
          "release_microphone_while_idle": true,
          "sound_effects": false,
          "show_dock_icon": false,
          "dictation_hotkey": { "keys": [{ "code": 80, "label": "F19" }] },
          "paste_last_hotkey": null,
          "capture": { "enabled": true, "hotkey": { "keys": [{ "code": 79, "label": "F18" }] } },
          "history_retention": "forever",
          "migrations": ["scrawl-capture-settings", "scrawl-routing-settings", "annotate-on-by-default", "anomaly-opcode-identity"]
        }
      }
    }
  },
  "benches": ["perf/**/*.bench.ts"],
  "metrics": { "equivalence": "2%" }
}
