// Kit's personal Cloudflare account, where both zones, the opcode-releases bucket
// and the old opcode-voice-site Worker live. Deploying this attaches all four
// hosts to this Worker (see README.md); `wrangler delete` with this config
// removes it again.
{
  "name": "opcode-legacy-downloads",
  "account_id": "19d80aa432b86d110c8e1480cf895f5c",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    // Routes run in front of the opcode-releases bucket's custom domains.
    { "pattern": "downloads.opcode.kitlangton.dev/*", "zone_name": "kitlangton.dev" },
    { "pattern": "downloads.opcode.kitlangton.com/*", "zone_name": "kitlangton.com" },
    // The website hosts move from opcode-voice-site to this Worker.
    { "pattern": "opcode.kitlangton.dev", "custom_domain": true },
    { "pattern": "opcode.kitlangton.com", "custom_domain": true },
  ],
}
